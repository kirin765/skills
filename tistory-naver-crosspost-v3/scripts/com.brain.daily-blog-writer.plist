<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brain.daily-blog-writer</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/kiwankim/projects/misc/brain &amp;&amp; /opt/homebrew/bin/claude -p "$(cat /Users/kiwankim/.claude/skills/tistory-naver-crosspost-v3/scripts/daily-writer-prompt.md)" --allowedTools "Bash" "Read" "Write" "Edit" "Glob" "Grep" "WebFetch" "Skill" "TodoWrite"</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>20</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/kiwankim/.naver-queue/logs/writer-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/kiwankim/.naver-queue/logs/writer-launchd.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
